---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in site.html_pages %}{% unless item.url == '/404.html' %}
  <url><loc>{{ item.url | absolute_url | xml_escape }}</loc></url>
{% endunless %}{% endfor %}
{% assign notes = site.notes | where: 'published', true %}
{% for note in notes %}{% if note.published == true and note.date <= site.time %}
  <url><loc>{{ note.url | absolute_url | xml_escape }}</loc><lastmod>{{ note.date | date_to_xmlschema }}</lastmod></url>
{% endif %}{% endfor %}
</urlset>
