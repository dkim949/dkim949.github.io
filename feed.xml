---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"><channel>
  <title>Dongin Kim — 작은 기록</title>
  <link>{{ '/' | absolute_url | xml_escape }}</link>
  <description>{{ site.description | xml_escape }}</description>
  {% assign notes = site.notes | where: 'published', true | sort: 'date' | reverse %}
  {% for note in notes %}{% if note.published == true and note.date <= site.time %}
  <item>
    <title>{% if note.title != '' %}{{ note.title | xml_escape }}{% else %}{{ note.content | markdownify | strip_html | truncate: 80 | xml_escape }}{% endif %}</title>
    <link>{{ note.url | absolute_url | xml_escape }}</link>
    <guid>{{ note.url | absolute_url | xml_escape }}</guid>
    <pubDate>{{ note.date | date_to_rfc822 }}</pubDate>
    <description>{{ note.content | markdownify | xml_escape }}</description>
  </item>
  {% endif %}{% endfor %}
</channel></rss>
